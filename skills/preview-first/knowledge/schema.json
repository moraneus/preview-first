    "expresses",
    "defaults_to",
    "evidence_for"
  ],
  "edge_evidence_expected": [
    "pairs_with",
    "suits",
    "avoid_with"
  ],
  "files": {
    "brief": {
      "type": "object",
      "required": [
        "product",
        "product_type",
        "page_type"
      ],
      "properties": {
        "product": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "product_type": {
          "type": "string"
        },
        "moods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "page_type": {
          "type": "string",
          "enum": [
            "marketing",
            "app",
            "content",
            "store"
          ]
        },
        "constraints": {
          "type": "object",
          "properties": {
            "brand_colors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fonts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "scheme": {
              "type": "string",
              "enum": [
                "light",
                "dark",
                "both"
              ]
            },
            "motion_level": {
              "type": "integer",
              "enum": [
                0,
                1,
                2,
                3
              ]
            }
          }
        },
        "admired": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "words": {
          "type": "object"
        }
      }
    },
    "directions": {
      "type": "object",
      "required": [
        "version",
        "brief",
        "directions"
      ],
      "properties": {
        "version": {
          "type": "integer"
        },
        "brief": {
          "type": "object"
        },
        "directions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "bundle"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "[A-Za-z0-9][A-Za-z0-9_-]{0,31}"
              },
              "name": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "bundle": {
                "type": "object",
                "required": [
                  "style",
                  "palette",
                  "type_pairing",
                  "treatments",
                  "motion",
                  "icon_set"
                ],
                "properties": {
                  "style": {
                    "type": "string"
                  },
                  "treatments": {
                    "type": "object"
                  },
                  "motion": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "motion_level": {
                    "type": "integer"
                  },
                  "icon_set": {
                    "type": "string"
                  },
                  "radius_scale": {
                    "type": "string"
                  },
                  "density": {
                    "type": "string"
                  },
                  "alternatives": {
                    "type": "object"
                  },
                  "ideas": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "overrides": {
                "type": "object"
              },
              "copy": {
                "type": "object"
              },
              "layout": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "direction"
      ],
      "properties": {
        "direction": {
          "type": "string"
        },
        "overrides": {
          "type": "object"
        },
        "selected_at": {
          "type": "string"
        }
      }
    },
    "device": {
      "type": "object",
      "required": [
        "id",
        "vendor",
        "model",
        "year",
        "kind",
        "viewport",
        "dpr",
        "safe_area",
        "cutout",
        "corner_radius",
        "share_rank",
        "default",
        "source",
        "verified"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "phone",
            "foldable",
            "tablet",
            "laptop",
            "desktop"
          ]
        },
        "viewport": {
          "type": "object",
          "required": [
            "w",
            "h"
          ]
        },
        "cutout": {
          "type": "string",
          "enum": [
            "island",
            "notch",
            "punch",
            "none"
          ]
        },
        "fold": {
          "type": "object"
        },
        "default": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        }
      }
    }
  }
}
