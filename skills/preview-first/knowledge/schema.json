  "palette_roles": [
    "bg",
    "surface",
    "surface_raised",
    "text",
    "text_muted",
    "border",
    "primary",
    "on_primary",
    "accent",
    "on_accent",
    "success",
    "warning",
    "danger",
    "focus"
  ],
  "palette_checks": [
    {
      "fg": "text",
      "bg": "bg",
      "role": "body"
    },
    {
      "fg": "text",
      "bg": "surface",
      "role": "body"
    },
    {
      "fg": "text",
      "bg": "surface_raised",
      "role": "body"
    },
    {
      "fg": "on_primary",
      "bg": "primary",
      "role": "label"
    },
    {
      "fg": "on_accent",
      "bg": "accent",
      "role": "label"
    },
    {
      "fg": "text_muted",
      "bg": "bg",
