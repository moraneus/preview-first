        "proof": "Used by 1,200 independent developers in 40 countries, per our October 2026 customer count.",
        "form": {"title": "Get the first invoice out today", "fields": ["Work email"], "submit": "Create account"},
        "footer": "Ledgerline is made in Tel Aviv."
