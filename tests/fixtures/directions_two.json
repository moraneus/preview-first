        "cta_primary": "Start free",
        "cta_secondary": "See a sample invoice",
        "nav": ["Product", "Pricing", "Docs", "Sign in"],
        "features": [
          {"title": "Pull requests become line items", "body": "Connect a repository and every merged PR is a draft line with hours from your commits."},
          {"title": "Clients approve in one click", "body": "Send a link, not a PDF. Approval, questions and payment live on one page."},
          {"title": "Taxes done per country", "body": "VAT, GST and sales tax rules applied by client address."}
